NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_anon_public_key
# Hanya dipakai di server, JANGAN diawali NEXT_PUBLIC
SERPAPI_KEY=isi_api_key_serpapi
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key
DEMO_RATE_LIMIT_SALT=isi_secret_acak_minimal_32_karakter
# Integrasi GoPay Merchant via MacroDroid
GOPAY_WEBHOOK_TOKEN=isi_string_acak_panjang
OWNER_USER_ID=uuid_user_anda_di_supabase_auth_users

# Interactive Demo memakai SUPABASE_SERVICE_ROLE_KEY di server saja.
# Jangan pernah menambahkan prefix NEXT_PUBLIC_ pada kedua secret di atas.

# Belibayar Sandbox - hanya untuk Interactive Demo, jangan gunakan kredensial live
BELIBAYAR_SANDBOX_API_KEY=byr_test_xxxxxxxxx
BELIBAYAR_SANDBOX_SECRET_KEY=isi_secret_key_sandbox
BELIBAYAR_SANDBOX_WEBHOOK_SECRET=isi_webhook_secret_sandbox
BELIBAYAR_SANDBOX_CALLBACK_URL=https://domain-kamu.my.id/api/webhooks/belibayar
BELIBAYAR_API_BASE_URL=https://api.belibayar.id

# Cek Harga otomatis: pemetaan produk -> bahan baku (hanya server, JANGAN diawali NEXT_PUBLIC)
# AI CAVA: FreeLLM gateway utama (routing Groq/Gemini); provider langsung tetap menjadi fallback.
FREELLM_API_URL=https://alamat-gateway-kamu.example/v1
FREELLM_API_KEY=isi_gateway_api_key_freellm
FREELLM_MODEL=auto
GROQ_API_KEY=isi_api_key_groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=isi_api_key_gemini
# Model Gemini yang digunakan untuk chat dan cadangan transkripsi audio
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# Cadangan chat terakhir setelah Groq dan Gemini (tidak digunakan untuk transkripsi audio)
# Default menggunakan router model gratis OpenRouter
OPENROUTER_API_KEY=isi_api_key_openrouter
OPENROUTER_MODEL=openrouter/free

# Suara jawaban CAVA melalui ElevenLabs (API key dan Voice ID tetap di server)
ELEVENLABS_API_KEY=isi_api_key_elevenlabs
ELEVENLABS_VOICE_ID=isi_voice_id_elevenlabs
ELEVENLABS_TTS_MODEL=eleven_v4

# Optional: secret khusus untuk token konfirmasi tindakan Cashie. Jika kosong, memakai SUPABASE_SERVICE_ROLE_KEY.
CAVA_ACTION_SECRET=
